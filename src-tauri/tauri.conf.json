{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VCT",
  "version": "0.1.0",
  "identifier": "com.vct.transcoder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VCT 视频转码",
        "width": 880,
        "height": 640,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": [],
    "copyright": "© 2026 VCT",
    "category": "Utility",
    "shortDescription": "极简可视化的 FFmpeg 视频转码工具",
    "longDescription": "VCT 是一款基于 FFmpeg 的桌面端视频转码应用，支持 H.265/AV1 编码、硬件加速检测与可视化进度。"
  }
}
