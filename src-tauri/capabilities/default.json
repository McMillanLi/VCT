{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VCT 默认权限：允许窗口控制、FFmpeg sidecar 执行、文件对话框、文件系统读写、通知与打开文件夹",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "notification:default",
    "opener:default",
    "opener:allow-open-path"
  ]
}
